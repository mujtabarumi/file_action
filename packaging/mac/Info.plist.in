<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>FileAction</string>
	<key>CFBundleDisplayName</key>
	<string>FileAction</string>
	<key>CFBundleIdentifier</key>
	<string>org.fileaction.app</string>
	<key>CFBundleVersion</key>
	<string>@VERSION@</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleExecutable</key>
	<string>fileaction</string>
	<key>CFBundleIconFile</key>
	<string>fileaction.icns</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>LSMinimumSystemVersion</key>
	<string>12.0</string>
	<!-- A menu-bar app: no Dock icon, no app menu. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>https://github.com/Metamorfolog/file_action</string>
	<!-- Finder's "Open With" lists the app for any file or folder (it opens the wheel for them). -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Any file</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.item</string>
				<string>public.folder</string>
			</array>
		</dict>
	</array>
	<!-- Shown by macOS when the app first asks Finder for the selected files (the ⌃⌥Space shortcut). -->
	<key>NSAppleEventsUsageDescription</key>
	<string>FileAction asks Finder which files are selected, to open the wheel for them.</string>
</dict>
</plist>
